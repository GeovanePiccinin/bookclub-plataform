{
  "name": "software-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm run db:generate",
    "prepare": "husky",
    "dev": "tsx scripts/run-env.ts development node_modules/next/dist/bin/next dev",
    "dev:test": "tsx scripts/run-env.ts test node_modules/next/dist/bin/next dev",
    "build": "tsx scripts/run-build.ts",
    "build:production": "tsx scripts/run-env.ts production node_modules/next/dist/bin/next build",
    "start": "tsx scripts/run-env.ts production node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "tsx scripts/run-env.ts schema node_modules/prisma/build/index.js generate",
    "db:up": "docker compose --env-file .env.development up -d --wait postgres",
    "db:down": "docker compose --env-file .env.development stop postgres",
    "db:migrate": "pnpm run db:migrate:development",
    "db:seed": "pnpm run db:seed:development",
    "setup": "pnpm run setup:local",
    "setup:local": "tsx scripts/setup-local.ts",
    "db:check:development": "tsx scripts/run-env.ts development node_modules/tsx/dist/cli.mjs scripts/check-db.ts",
    "db:check:test": "tsx scripts/run-env.ts test node_modules/tsx/dist/cli.mjs scripts/check-db.ts",
    "db:check:production": "tsx scripts/run-env.ts production node_modules/tsx/dist/cli.mjs scripts/check-db.ts",
    "db:migrate:development": "tsx scripts/run-env.ts development node_modules/tsx/dist/cli.mjs scripts/prisma-command.ts migrate deploy",
    "db:migrate:test": "tsx scripts/run-env.ts test node_modules/tsx/dist/cli.mjs scripts/prisma-command.ts migrate deploy",
    "db:migrate:production": "tsx scripts/run-env.ts production node_modules/tsx/dist/cli.mjs scripts/prisma-command.ts migrate deploy",
    "db:seed:development": "tsx scripts/run-env.ts development node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:seed:test": "tsx scripts/run-env.ts test node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:seed:production": "tsx scripts/run-env.ts production node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:reset:test": "tsx scripts/run-env.ts test node_modules/tsx/dist/cli.mjs scripts/reset-test-db.ts",
    "test": "tsx scripts/run-env.ts test node_modules/vitest/vitest.mjs run",
    "test:run": "tsx scripts/run-env.ts test node_modules/vitest/vitest.mjs run",
    "test:watch": "tsx scripts/run-env.ts test node_modules/vitest/vitest.mjs",
    "test:local": "pnpm run db:up && pnpm run db:migrate:test && pnpm run test:run"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,mdx,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/nextjs": "^11.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "plop": "^4.0.5",
    "prettier": "^3.10.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0"
}
