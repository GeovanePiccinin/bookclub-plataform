import { Prisma } from "@/generated/prisma/client";

import { prisma } from "@/lib/db/prisma";

import type {
  Create{{pascalCase entityName}}Data,
  Update{{pascalCase entityName}}Data,
} from "./{{kebabCase entityName}}.schema";
import type {
  {{pascalCase entityName}}ListItem,
  {{pascalCase entityName}}ListQuery,
  {{pascalCase entityName}}ListResult,
} from "./{{kebabCase entityName}}.query";

const {{camelCase entityName}}Select = {
  id: true,
{{#each fields}}
  {{name}}: true,
{{/each}}
} satisfies Prisma.{{pascalCase entityName}}Select;

export async function find{{pascalCase pluralName}}(
  tenantId: string,
  query: {{pascalCase entityName}}ListQuery,
): Promise<{{pascalCase entityName}}ListResult> {
  const { search, page, pageSize, sortBy, sortDirection } = query;
  const where: Prisma.{{pascalCase entityName}}WhereInput = {
    tenantId,
{{#if hasSearchableFields}}
    ...(search
      ? {
          OR: [
{{#each searchableFields}}
            {
              {{name}}: {
                contains: search,
                mode: "insensitive",
              },
            },
{{/each}}
          ],
        }
      : {}),
{{/if}}
  };
  const orderBy: Prisma.{{pascalCase entityName}}OrderByWithRelationInput = {
    [sortBy]: sortDirection,
  };

  const [records, total] = await prisma.$transaction([
    prisma.{{camelCase entityName}}.findMany({
      where,
      orderBy,
      skip: (page - 1) * pageSize,
      take: pageSize,
      select: {{camelCase entityName}}Select,
    }),
    prisma.{{camelCase entityName}}.count({ where }),
  ]);

  const items: {{pascalCase entityName}}ListItem[] = records.map((record) => ({
    id: record.id,
{{#each fields}}
    {{name}}: {{{mapExpression}}},
{{/each}}
  }));

  return {
    items,
    total,
    page,
    pageSize,
    pageCount: Math.ceil(total / pageSize),
  };
}

export async function create{{pascalCase entityName}}(
  tenantId: string,
  input: Create{{pascalCase entityName}}Data,
): Promise<void> {
  await prisma.{{camelCase entityName}}.create({
    data: {
      tenantId,
{{#each fields}}
      {{name}}: {{{writeExpression}}},
{{/each}}
    },
  });
}

export async function update{{pascalCase entityName}}(
  tenantId: string,
  input: Update{{pascalCase entityName}}Data,
): Promise<void> {
  const result = await prisma.{{camelCase entityName}}.updateMany({
    where: {
      id: input.id,
      tenantId,
    },
    data: {
{{#each fields}}
      {{name}}: {{{writeExpression}}},
{{/each}}
    },
  });

  if (result.count === 0) {
    throw new Error({{{messages.notFound}}});
  }
}

export async function delete{{pascalCase entityName}}(
  tenantId: string,
  {{camelCase entityName}}Id: string,
): Promise<void> {
  const result = await prisma.{{camelCase entityName}}.deleteMany({
    where: {
      id: {{camelCase entityName}}Id,
      tenantId,
    },
  });

  if (result.count === 0) {
    throw new Error({{{messages.notFound}}});
  }
}
