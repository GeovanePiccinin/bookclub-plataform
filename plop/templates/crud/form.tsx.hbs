"use client";

import { zodResolver } from "@hookform/resolvers/zod";
import { useForm } from "react-hook-form";

import { Button } from "@/components/ui/button";
import { Form } from "@/components/ui/form";
{{#if hasInputFields}}
import { Input } from "@/components/ui/input";
{{/if}}
{{#if hasLongTextFields}}
import { Textarea } from "@/components/ui/textarea";
{{/if}}

import {
  create{{pascalCase entityName}}Schema,
  type Create{{pascalCase entityName}}Data,
  type Create{{pascalCase entityName}}Input,
} from "./{{kebabCase entityName}}.schema";
import type { {{pascalCase entityName}}ListItem } from "./{{kebabCase entityName}}.query";

interface {{pascalCase entityName}}FormProps {
  {{camelCase entityName}}?: {{pascalCase entityName}}ListItem;
  isPending: boolean;
  onSubmit: (data: Create{{pascalCase entityName}}Data) => void;
  onCancel: () => void;
}

export function {{pascalCase entityName}}Form({
  {{camelCase entityName}},
  isPending,
  onSubmit,
  onCancel,
}: {{pascalCase entityName}}FormProps) {
  const form = useForm<
    Create{{pascalCase entityName}}Input,
    undefined,
    Create{{pascalCase entityName}}Data
  >({
    resolver: zodResolver(create{{pascalCase entityName}}Schema),
    defaultValues: {
{{#each fields}}
      {{name}}: {{{formDefaultExpression}}},
{{/each}}
    },
  });

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-4">
{{#each fields}}
{{#if isBoolean}}
        <div className="flex items-center gap-2">
          <input
            id="{{kebabCase ../entityName}}-{{kebabCase name}}"
            type="checkbox"
            disabled={isPending}
            {...form.register("{{name}}")}
          />
          <label
            htmlFor="{{kebabCase ../entityName}}-{{kebabCase name}}"
            className="text-sm font-medium"
          >
            {{label}}
          </label>
        </div>
{{else if isEnum}}
        <div className="space-y-2">
          <label
            htmlFor="{{kebabCase ../entityName}}-{{kebabCase name}}"
            className="text-sm font-medium"
          >
            {{label}}
          </label>
          <select
            id="{{kebabCase ../entityName}}-{{kebabCase name}}"
            className="h-8 w-full rounded-lg border border-input bg-background px-2.5 text-sm"
            disabled={isPending}
            {...form.register("{{name}}")}
          >
{{#if optional}}
            <option value="">Selecione...</option>
{{/if}}
{{#each enumValues}}
            <option value="{{this}}">{{this}}</option>
{{/each}}
          </select>
          {form.formState.errors.{{name}} ? (
            <p className="text-sm text-destructive">
              {form.formState.errors.{{name}}.message}
            </p>
          ) : null}
        </div>
{{else}}
        <div className="space-y-2">
          <label
            htmlFor="{{kebabCase ../entityName}}-{{kebabCase name}}"
            className="text-sm font-medium"
          >
            {{label}}
          </label>
{{#if isLongText}}
          <Textarea
            id="{{kebabCase ../entityName}}-{{kebabCase name}}"
            disabled={isPending}
            {...form.register("{{name}}")}
          />
{{else}}
          <Input
            id="{{kebabCase ../entityName}}-{{kebabCase name}}"
            type="{{inputType}}"
            disabled={isPending}
            {...form.register("{{name}}")}
          />
{{/if}}
          {form.formState.errors.{{name}} ? (
            <p className="text-sm text-destructive">
              {form.formState.errors.{{name}}.message}
            </p>
          ) : null}
        </div>
{{/if}}
{{/each}}
        <div className="flex justify-end gap-2 pt-2">
          <Button
            type="button"
            variant="outline"
            onClick={onCancel}
            disabled={isPending}
          >
            Cancelar
          </Button>
          <Button type="submit" disabled={isPending}>
            {isPending
              ? "Salvando..."
              : {{camelCase entityName}}
                ? "Salvar alterações"
                : "Cadastrar"}
          </Button>
        </div>
      </form>
    </Form>
  );
}
{{#if hasDateTimeFields}}

function formatDateTimeLocal(value: Date): string {
  const localOffset = value.getTimezoneOffset() * 60_000;

  return new Date(value.getTime() - localOffset).toISOString().slice(0, 16);
}
{{/if}}
