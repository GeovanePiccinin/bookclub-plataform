{{#if createRequiresAdmin}}
  requireRole(actor, "ADMIN");
{{/if}}
  const data = create{{pascalCase entityName}}Schema.parse(input);

  try {
    await create{{pascalCase entityName}}(actor.tenantId, data);

    logger.info(
      {
        operation: "{{camelCase entityName}}.create",
        tenantId: actor.tenantId,
      },
      "{{pascalCase entityName}} created",
    );
  } catch (error: unknown) {
    logger.error(
      {
        operation: "{{camelCase entityName}}.create",
        tenantId: actor.tenantId,
        error,
      },
      "Failed to create {{camelCase entityName}}",
    );

    throw error;
  }
}

