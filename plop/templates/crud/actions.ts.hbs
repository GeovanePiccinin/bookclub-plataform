export async function get{{pascalCase pluralName}}(
  input: unknown,
): Promise<{{pascalCase entityName}}ListResult & {
  canCreate: boolean;
  canManage: boolean;
}> {
  const actor = await requireAuthenticatedActor();
{{#if readRequiresAdmin}}
  requireRole(actor, "ADMIN");
{{/if}}

  const query = {{camelCase entityName}}ListQuerySchema.parse(input);
  const result = await find{{pascalCase pluralName}}(actor.tenantId, query);

  return {
    ...result,
    canCreate: {{#if createRequiresAdmin}}actor.role === "ADMIN"{{else}}true{{/if}},
    canManage: actor.role === "ADMIN",
  };
}

export async function create{{pascalCase entityName}}Action(
  input: unknown,
): Promise<void> {
