# Local Docker Compose PostgreSQL only. Do not use production credentials here.
STARTER_POSTGRES_PORT=54329
DATABASE_URL=postgresql://starter:starter_local_only@127.0.0.1:${STARTER_POSTGRES_PORT}/software_starter_dev?schema=public
DATABASE_SCHEMA=public

# Local demonstration accounts only.
AUTH_SECRET=local-development-secret-change-before-deployment
NEXTAUTH_URL=http://localhost:3000
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=admin123
